# Copy to .env and fill in. Read by config.py via python-dotenv.

# Required for the live REPL / e2e scenario (kill_switch_test.py needs none —
# the gate aborts before the model is built).
NVIDIA_API_KEY=nvapi-...

# Optional overrides (defaults shown)
# SENTINEL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# SENTINEL_TEMPERATURE=0
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# FALKOR_HOST=127.0.0.1
# FALKOR_PORT=6379
